<Window x:Class="TaskbarVisu.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:TaskbarVisu.UI"
        Title="TaskbarVisu — Paramètres"
        Width="1000" Height="740" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Icon="/Assets/TaskbarVisu.ico">
    <Window.Resources>
        <!-- Navigation latérale façon Paramètres de Windows 11 : liseré d'accentuation sur la page ouverte. -->
        <!-- Le style Fluent des onglets grise le texte des onglets non choisis et de leur contenu : on garde le texte principal. -->
        <Style x:Key="NavItem" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="0,1,0,1" Background="Transparent">
                            <Border x:Name="Bg" CornerRadius="5" Background="Transparent" />
                            <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                       HorizontalAlignment="Left" Visibility="Hidden"
                                       Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <ContentPresenter ContentSource="Header" Margin="14,9,12,9" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabs" TargetType="TabControl">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="232" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel IsItemsHost="True" Margin="8,84,8,8" />
                            <!-- Ce nom permet aux lecteurs d'écran (UI Automation) d'atteindre le contenu de la page ouverte. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interrupteur (case à cocher) façon Windows 11. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    Background="{DynamicResource ToggleSwitchFillOff}"
                                    BorderBrush="{DynamicResource ToggleSwitchStrokeOff}" />
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Style="{StaticResource NavTabs}" ItemContainerStyle="{StaticResource NavItem}">
            <!-- Ma barre : la miniature, le module choisi et tous ses réglages, puis les modules à ajouter. -->
            <TabItem x:Name="TabBar">
                <ScrollViewer x:Name="BarScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BarRoot" Margin="20,18,28,24" />
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabStyle">
                <!-- Titre et aperçu en direct épinglés : chaque réglage plus bas s'y voit sans remonter. -->
                <DockPanel>
                    <StackPanel x:Name="StyleHeader" DockPanel.Dock="Top" Margin="20,18,28,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="StylePanel" Margin="20,0,28,24" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="TabSettings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel" Margin="20,18,28,24" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bas de la navigation, visible depuis chaque page : masquer, pause, et une mise à jour quand il y en a une. -->
        <StackPanel x:Name="SideActions" Width="200" Margin="22,0,0,14" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <StackPanel x:Name="UpdateBox" />
            <UniformGrid Columns="2">
                <Button x:Name="HideButton" Margin="0,0,3,0" HorizontalAlignment="Stretch" />
                <Button x:Name="PauseButton" Margin="3,0,0,0" HorizontalAlignment="Stretch" />
            </UniformGrid>
        </StackPanel>

        <!-- Nom de l'application au-dessus de la navigation, en matrice de points comme les modules. -->
        <StackPanel x:Name="AppHeader" Orientation="Horizontal" Margin="22,24,0,0" VerticalAlignment="Top"
                    HorizontalAlignment="Left" IsHitTestVisible="False">
            <Image Source="/Assets/TaskbarVisu.ico" Width="32" Height="32" Margin="0,0,12,0"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
                <ui:DotMatrixText x:Name="AppName" Text="TASKBARVISU" Dot="2" />
                <TextBlock x:Name="VersionText" FontSize="11" Opacity="0.6" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>

        <Border x:Name="Footer" Grid.Row="1" Padding="22,8,22,10"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>
        <!-- Guide de démarrage : remplace la fenêtre le temps de ses cinq étapes. -->
        <Grid x:Name="WelcomeRoot" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
